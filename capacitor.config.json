{
  "appId": "com.jiankaili.macroradar",
  "appName": "Macro Radar",
  "webDir": "public",
  "server": {
    "url": "https://macro-radar-eight.vercel.app",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#050B16",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#08111F"
    }
  }
}
